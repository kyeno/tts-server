# Address and port for the HTTP server (default: 0.0.0.0:8080)
ADDRESS_LISTEN=0.0.0.0:7423

# Directory containing Piper TTS model files (.onnx + .json pairs)
# The request only needs the model filename, not the full path
DIR_MODEL=/home/ai/models/piper

# Optional: RAM disk directory for model files (e.g., tmpfs mount).
# When set, models are automatically verified, copied to RAM on startup,
# and cleaned up on graceful shutdown.
# DIR_RAMDISK_MODEL=/mnt/ram/tts-server-models/

# Directory for temporary WAV files during pipeline processing
# Will be created if it does not exist (server crashes if creation failures)
DIR_TEMP=/tmp/tts-server/

# Directory containing optional intro/outro sound files referenced by name in requests.
# Relative paths are resolved against the project root. Default: ./sounds/
DIR_SOUNDS=sounds/

# Optional: override default binary paths for external dependencies.
# If not set, the server looks for 'piper', 'sox', 'nc' in $PATH ('ffmpeg' is looked up
# lazily on first use of "intro"/"outro").
# PATH_PIPER=/usr/local/bin/piper
# PATH_SOX=/usr/bin/sox
# PATH_NETCAT=/bin/nc
# PATH_FFMPEG=/usr/bin/ffmpeg

# Optional: respond immediately after request validation without waiting for pipeline.
# When enabled, the server returns 200 as soon as validation passes and runs the
# TTS pipeline asynchronously in the background. Pipeline errors will still be logged.
# Set to "true" or "1" to enable. Default (when unset or "false"): wait for pipeline.
FIRE_AND_FORGET=true

# Optional: maximum number of pipelines allowed to run concurrently.
# Protects the server from job floods when FIRE_AND_FORGET is enabled - requests
# beyond the limit receive HTTP 429 until a slot frees up.
# Default (unset or <= 0): unlimited.
# MAX_CONCURRENT_PIPELINES=8

# Optional: pause between queued streams to the same output endpoint.
# Applies after a stream finishes and before the next queued item starts.
# Default: 5000 milliseconds.
STREAM_QUEUE_PAUSE_MS=1500

# =============================================================================
# Docker deployment (optional) - see README "Docker Deployment".
#
# These variables are consumed by docker-compose.yml. They are ignored by the
# server itself, so leaving them here is safe for non-Docker deployments.
#
# NOTE: DIR_MODEL and DIR_SOUNDS above are HOST paths. Inside the container the
# server always uses the mount targets /data/piper-models and /app/sounds, and
# docker-compose.yml overrides them accordingly.
# =============================================================================

# Host directory that holds Piper models (X.onnx + X.onnx.json pairs).
# Mounted read-only at /data/piper-models. Default: ./models
# MODELS_DIR=./models

# Host directory with intro/outro sound files. Mounted read-only at /app/sounds.
# Default: ./sounds
# SOUNDS_DIR=./sounds

# TCP port the server binds on the host (host networking - the port is used as-is).
# Default: 7423
# TTS_HTTP_PORT=7423

# tmpfs sizes for the in-container RAM disk and temp directory.
# The RAM disk must be larger than your total model set, otherwise startup exits.
# Default: 2g / 1g
# RAMDISK_SIZE=2g
# TMP_SIZE=1g

# Disable the RAM disk by clearing this value (models are then read from the mount).
# DIR_RAMDISK_MODEL=

# Node.js runtime pinned to a patched release. 22.23.4 is the 22.x release of the
# Node.js security advisory of 2026-10-21 (dns.resolve NUL truncation, TLS hostname
# bypasses, Brotli decoder RCE, ...). The Dockerfile refuses to build on anything
# older. Bump to the newest patched 22.x release after each advisory:
#   https://nodejs.org/en/blog/vulnerability
# Default: 22.23.4
# TTS_NODE_VERSION=22.23.4

# piper-tts version pinned into the image, and the experimental CUDA build
# (PIPER_CUDA=1 swaps onnxruntime-gpl for onnxruntime-gpu; see README).
# Default: 1.8.0 / 0
# PIPER_VERSION=1.8.0
# PIPER_CUDA=0

# Image tag suffix and env file used by compose (compose reads .env automatically).
# Default: latest / .env
# TTS_IMAGE_TAG=latest
# TTS_ENV_FILE=.env
