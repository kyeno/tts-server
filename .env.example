# Address and port for the HTTP server (default: 0.0.0.0:8080)
ADDRESS_LISTEN=0.0.0.0:7423

# Directory containing Piper TTS model files (.onnx + .json pairs)
# The request only needs the model filename, not the full path
DIR_MODEL=/home/ai/models/piper

# Optional: RAM disk directory for model files (e.g., tmpfs mount).
# When set, models are automatically verified, copied to RAM on startup,
# and cleaned up on graceful shutdown.
# DIR_RAMDISK_MODEL=/mnt/ram/tts-server-models/

# Directory for temporary WAV files during pipeline processing
# Will be created if it does not exist (server crashes if creation failures)
DIR_TEMP=/tmp/tts-server/

# Directory containing optional intro/outro sound files referenced by name in requests.
# Relative paths are resolved against the project root. Default: ./sounds/
DIR_SOUNDS=sounds/

# Optional: override default binary paths for external dependencies.
# If not set, the server looks for 'piper', 'sox', 'nc' in $PATH ('ffmpeg' is looked up
# lazily on first use of "intro"/"outro").
# PATH_PIPER=/usr/local/bin/piper
# PATH_SOX=/usr/bin/sox
# PATH_NETCAT=/bin/nc
# PATH_FFMPEG=/usr/bin/ffmpeg

# Optional: respond immediately after request validation without waiting for pipeline.
# When enabled, the server returns 200 as soon as validation passes and runs the
# TTS pipeline asynchronously in the background. Pipeline errors will still be logged.
# Set to "true" or "1" to enable. Default (when unset or "false"): wait for pipeline.
FIRE_AND_FORGET=true

# Optional: maximum number of pipelines allowed to run concurrently.
# Protects the server from job floods when FIRE_AND_FORGET is enabled - requests
# beyond the limit receive HTTP 429 until a slot frees up.
# Default (unset or <= 0): unlimited.
# MAX_CONCURRENT_PIPELINES=8

# Optional: pause between queued streams to the same output endpoint.
# Applies after a stream finishes and before the next queued item starts.
# Default: 5000 milliseconds.
STREAM_QUEUE_PAUSE_MS=5000